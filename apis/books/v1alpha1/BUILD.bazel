load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "booksv1alpha1_proto",
    srcs = [
        "book.proto",
        "session.proto",
    ],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "booksv1alpha1_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/Toandos/toando/apis/books/v1alpha1",
    proto = ":booksv1alpha1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "v1alpha1",
    embed = [":booksv1alpha1_go_proto"],
    importpath = "github.com/Toandos/toando/apis/books/v1alpha1",
    visibility = ["//visibility:public"],
)
