load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "app_lib",
    srcs = ["main.go"],
    importpath = "github.com/Toandos/toando/products/hosting/session-service/app",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "app",
    embed = [":app_lib"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    package_dir = "/app",
)

oci_image(
    name = "app_image",
    base = "@distroless_static",
    entrypoint = ["/app"],
    tars = [":app_layer"],
    visibility = ["//visibility:public"],
    workdir = "/app",
)

oci_push(
    name = "push_image",
    image = ":app_image",
    remote_tags = ["latest"],
    repository = "ghcr.io/Toandos/hosting-session-service",
    visibility = ["//visibility:public"],
)
